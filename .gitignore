__pycache__/
*.pyc

# The solver writes its presets and itinerary next to the script, so anything
# that runs it from solver/ -- the backend service, a local CLI run -- leaves
# output here.  Published presets live in docs/data/ and are committed from
# there; these are scratch.
solver/docs/
solver/smokies_itinerary_*.txt
!solver/smokies_itinerary_12h.txt

# API keys.  fetch_drive_times.py reads GOOGLE_MAPS_API_KEY from here; the file
# itself must never be committed.  See .env.example for the shape.
.env

# CARP batch output.  tools/carp_supported.py writes day assignments, candidate
# presets and its log here; only presets promoted into docs/data are committed.
out/
