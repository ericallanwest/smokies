# Copy to .env and fill in.  .env is gitignored; this file is not.
#
# Google Maps Routes API key, used only by tools/fetch_drive_times.py to price
# mid-day shuttle drives.  Needs the Routes API enabled on the project.  If the
# key is restricted by HTTP referrer it will 403 from the command line -- an IP
# restriction, or none, is what works here.
GOOGLE_MAPS_API_KEY=
